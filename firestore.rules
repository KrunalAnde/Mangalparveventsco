rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Allow connection check for app boot
    match /test/connection {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == "krunalande1998@gmail.com");
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(customerId);
      allow delete: if isSignedIn();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(eventId);
      allow delete: if isSignedIn();
    }

    // Vendors Collection
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(vendorId);
      allow delete: if isSignedIn();
    }

    // Vendor Assignments
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(assignmentId);
      allow delete: if isSignedIn();
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(quoteId);
      allow delete: if isSignedIn();
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(invoiceId);
      allow delete: if isSignedIn();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(paymentId);
      allow delete: if isSignedIn();
    }

    // Execution Tasks Collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(taskId);
      allow delete: if isSignedIn();
    }

    // Audit Logs Collection (Append-only)
    match /audit_logs/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(auditId);
      allow update, delete: if false; // Immutable audit log
    }
  }
}
